{
  "name": "chatshell",
  "productName": "ChatShell",
  "version": "0.2.0",
  "description": "网页版 AI 的桌面外壳：快捷启动 + 可改造注入层（登录态持久化 / 托盘 / 全局热键 / 紧凑小窗 / 快捷问答）",
  "main": "src/main/index.js",
  "author": "zenty-me",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenty-me/ChatShell.git"
  },
  "homepage": "https://github.com/zenty-me/ChatShell#readme",
  "bugs": {
    "url": "https://github.com/zenty-me/ChatShell/issues"
  },
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --dev",
    "verify:login": "node scripts/launch.js --verify-login",
    "self-check": "node scripts/launch.js --self-check",
    "test:ask": "node scripts/launch.js --test-quickask",
    "probe:chat": "node scripts/launch.js --probe-chat",
    "check": "node scripts/syntax-check.js",
    "build:preload": "node scripts/build-preload.js",
    "icon": "node scripts/make-icon.js",
    "pack:dir": "npm run build:preload && electron-builder --dir",
    "dist": "npm run build:preload && electron-builder"
  },
  "build": {
    "appId": "com.github.zenty-me.chatshell",
    "productName": "ChatShell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChatShell"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "electron-log": "^5.4.4",
    "marked": "^18.0.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
